 "structures": [
  {
   "id": "non-solo",
   "name": "\"Non si tratta solo di X, ma di Y\"",
   "regex": "(?i)\\bnon (?:si tratta|è) (?:solo|soltanto|semplicemente) [^.!?\\n]{2,80}[,.;]\\s*(?:ma|è|si tratta)\\b",
   "fix": "Dì Y e basta. La negazione messa in scena è il tic più riconoscibile."
  },
  {
   "id": "non-solo-ma-anche",
   "name": "\"Non solo X, ma anche Y\"",
   "regex": "(?i)\\bnon solo\\b[^.!?\\n]{2,80}\\bma anche\\b",
   "fix": "Scegli quello che conta e dillo da solo."
  },
  {
   "id": "non-e-x-e-y",
   "name": "\"Non è X. È Y.\"",
   "regex": "(?i)\\bnon è [^.!?\\n]{2,50}[.!]\\s*È\\b",
   "fix": "Togli la frase in negativo."
  },
  {
   "id": "il-risultato",
   "name": "Domanda-teaser di una parola (\"Il risultato?\")",
   "regex": "(?im)^\\s*(?:il risultato|la verità|il segreto|il problema|la parte migliore|la svolta|la lezione|il motivo|la risposta)\\?\\s*$",
   "fix": "Dì direttamente la cosa."
  },
  {
   "id": "ecco-perche",
   "name": "\"Ecco perché\" / \"Ecco come\" a inizio riga",
   "regex": "(?im)^\\s*ecco (?:perché|come|cosa|il motivo)\\b",
   "fix": "Entra nel merito senza annunciarlo."
  },
  {
   "id": "triade",
   "name": "Triade (X, Y e Z.)",
   "regex": "(?i)\\b\\w+, \\w+ e \\w+\\.",
   "fix": "Tieni le due cose vere o aggiungi una quarta più storta."
  },
  {
   "id": "emoji-razzo",
   "name": "Emoji da template",
   "regex": "[🚀🔥💡✨🎯👇✅]",
   "fix": "Toglile o usane una sola che diresti a voce."
  },
  {
   "id": "muro-hashtag",
   "name": "Muro di hashtag",
   "regex": "(?:#\\w+[ \\t]*){5,}",
   "fix": "Massimo tre, in fondo."
  },
  {
   "id": "in-conclusione",
   "name": "Chiusa da tema (\"In conclusione\", \"In sintesi\")",
   "regex": "(?im)^\\s*(?:in conclusione|in sintesi|riassumendo|per concludere)\\b",
   "fix": "Finisci sull'idea, non sul riassunto."
  },
  {
   "id": "esca-commenti",
   "name": "Esca per i commenti",
   "regex": "(?im)(?:cosa ne pensate\\?|tu cosa ne pensi\\?|siete d'accordo\\?|sei d'accordo\\?|chi altro\\?|sbaglio\\?)\\s*$",
   "fix": "Fai una domanda specifica a cui si risponde con un'esperienza, o niente."
  },
  {
   "id": "come-ai",
   "name": "Residuo da modello",
   "regex": "(?i)\\bcome (?:modello linguistico|intelligenza artificiale|IA),",
   "fix": "Eliminare."
  },
  {
   "id": "lista-due-punti",
   "name": "Titoletti in grassetto con due punti",
   "regex": "(?m)^\\s*(?:[-*]\\s*)?\\*\\*[^*\\n]{2,40}:\\*\\*",
   "fix": "Su LinkedIn il grassetto non c'è: scrivi frasi."
  }
 ]
